{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "addons/godot_mcp_toolkit/CompanionSkills"
    ]
  },
  "mcp": {
    "godot-mcp-toolkit": {
      "type": "local",
      "command": ["npx", "-y", "@npgamedev/godot-mcp-server"],
      "enabled": true,
      "environment": {
        "GODOT_MCP_CONFIG_VERSION": "1"
      },
      "timeout": 300000
    }
  }
}